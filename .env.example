# Copy to .env and adjust. Everything is optional; secrets can be set from the web UI instead (which wins).
TZ=UTC                         # your timezone, e.g. America/New_York
WEB_BIND=127.0.0.1             # address the web UI listens on; use the host's LAN IP to reach it remotely
# WEB_PORT=8093
# LITELLM_API_KEY=sk-REPLACE_ME
# OPENHOP_API_KEY=REPLACE_ME   # openHop web API token, for the home repeater stats tools (read-only use)
# WEB_PASSWORD=REPLACE_ME      # if neither this nor a UI password exists, one is generated into data/initial_password.txt
# CH_PRIVATE_SECRET=00112233445566778899aabbccddeeff   # referenced by a channel's secret_env
